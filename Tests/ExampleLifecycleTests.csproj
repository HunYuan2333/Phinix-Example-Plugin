<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <PhinixRoot Condition="'$(PhinixRoot)' == ''">$(MSBuildThisFileDirectory)../../Phinix-Rework</PhinixRoot>
    <HostAssemblies>$(PhinixRoot)/Output/phinix-rework/Common/Assemblies</HostAssemblies>
    <GameReferences Condition="'$(GameReferences)' == ''">$(PhinixRoot)/GameDlls</GameReferences>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Phinix.Example.Basic"><HintPath>../example/bin/Release/net472/Phinix.Example.Basic.dll</HintPath></Reference>
    <Reference Include="Utils"><HintPath>$(HostAssemblies)/03-Utils.dll</HintPath></Reference>
    <Reference Include="ClientExtensionAbstractions"><HintPath>$(HostAssemblies)/10-ClientExtensionAbstractions.dll</HintPath></Reference>
    <Reference Include="Phinix.ClientComposition"><HintPath>$(HostAssemblies)/Phinix.ClientComposition.dll</HintPath></Reference>
    <Reference Include="Google.Protobuf"><HintPath>$(HostAssemblies)/02-Protobuf.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameReferences)/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameReferences)/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameReferences)/UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameReferences)/UnityEngine.TextRenderingModule.dll</HintPath></Reference>
    <None Include="$(HostAssemblies)/Autofac.dll;$(HostAssemblies)/Microsoft.Bcl.AsyncInterfaces.dll;$(HostAssemblies)/System.Diagnostics.DiagnosticSource.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
